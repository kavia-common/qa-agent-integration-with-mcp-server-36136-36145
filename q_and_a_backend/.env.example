# Q&A Agent backend environment example

# Base URL to your MCP HTTP bridge, e.g., https://mcp.example.com
MCP_BRIDGE_URL=https://your-mcp-bridge.example.com

# Optional API key for the MCP bridge (sent as Bearer token)
MCP_API_KEY=your-api-key

# Validate TLS certificates (true/false), default true
MCP_VERIFY_TLS=true
